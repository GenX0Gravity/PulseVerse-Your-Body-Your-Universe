# ==============================================================================
# PulseVerse — Your Body, Your Universe
# Local Development Environment Configuration
# ==============================================================================

# Presage Technologies SmartSpectra SDK API Key
# Obtain your development key from: https://smartspectra.presagetech.com/
# NEVER commit your real API key to version control.
VITE_SMARTSPECTRA_API_KEY=your_presage_smartspectra_api_key_here

# Application Environment (development | production)
NODE_ENV=development

# Optional default camera device ID (leave empty for system default webcam)
VITE_DEFAULT_CAMERA_DEVICE_ID=

# Metrics collection flags (1 = enabled, 0 = disabled)
VITE_ENABLE_CARDIO_METRICS=1
VITE_ENABLE_BREATHING_METRICS=1
VITE_ENABLE_FACE_METRICS=1

# Electron window defaults
VITE_DEV_SERVER_PORT=5173
VITE_ENABLE_DEVTOOLS=1
