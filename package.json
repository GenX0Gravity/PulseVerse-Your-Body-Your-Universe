{
  "name": "pulseverse",
  "version": "1.0.0",
  "description": "PulseVerse — Your Body, Your Universe: A privacy-conscious, immersive human-sensing desktop experience powered by Presage SmartSpectra SDK.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "author": "PulseVerse Team",
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --win --x64",
    "build:renderer": "tsc && vite build && node scripts/sync-website.js",
    "build:web": "tsc && vite build && node scripts/sync-website.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.10",
    "@smartspectra/node-sdk": "^3.5.0",
    "@smartspectra/node-sdk-win32-x64": "^3.5.0",
    "koffi": "^2.9.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.4"
  }
}
